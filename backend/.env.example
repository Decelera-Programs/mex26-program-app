# --- Database (Supabase Postgres) ---
DATABASE_URL=postgresql://postgres:password@host:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:password@host:5432/postgres

# --- Supabase project ---
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Server ---
PORT=8787

# --- Web Push (VAPID) ---
# If unset, ephemeral keys are generated in memory (dev only — subscriptions break on restart).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@decelera.com

# --- Shared secrets ---
JOBS_API_KEY=change-me                 # sent as x-job-key on POST /jobs/*
CAMPAIGN_ADMIN_API_KEY=change-me       # sent as x-admin-key on /campaigns/*
CAMPAIGN_ADMIN_EMAILS=you@decelera.com # comma-separated allowlist for /campaigns/*

# --- Storage ---
SUPABASE_AUDIO_BUCKET=one-on-ones-audio

# --- OpenAI (transcription + AI matchmaking) ---
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_MATCHING_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
